{
  "schema": "gaia-profile-bundle-v1",
  "bundle_id": "sample-packs",
  "label": "Sample pack layouts",
  "profiles": [
    {
      "id": "sample_pack",
      "label": "Sample pack",
      "description": "An immutable collected pack that preserves every original file and relative path.",
