# === SIN / GAIA DSP Processor Environment Configuration ===
# Copy this file to `.env` (gitignored) to customize local paths or runtimes.
# OS environment variables always take precedence over values in `.env`.

# Where SIN downloads and stores high-level DSP models (default: <repo>/.gaia/models).
# Human-browsable folder placed right beside .gaia/profiles/ for future GAIA model management.
SIN_MODELS_DIR=.gaia/models

# Optional extra directories to probe read-only before downloading.
# Separate multiple directories with ';' on Windows or ':' on macOS/Linux (or commas).
SIN_EXTRA_MODEL_DIRS=

# Probe global ~/.cache/huggingface and ~/.cache/torch caches before downloading (1 = enabled, 0 = disabled).
SIN_PREFER_GLOBAL_MODELS=1

# Ephemeral float16 stem & STFT analysis cache (safe to delete anytime).
SIN_DSP_CACHE_DIR=.runtime/dsp_cache
SIN_DSP_CACHE_MAX_GB=4.0

# Optional external Python executable (e.g., global Python 3.11 or shared ML venv) for subprocess bridge.
# Leave blank for automatic PATH discovery (e.g., global python / demucs).
# Windows example: C:\Users\<you>\AppData\Local\Programs\Python\Python311\python.exe
# macOS/Linux example: /opt/homebrew/bin/python3
SIN_EXTERNAL_PYTHON=

# Preferred compute device across OSes: auto | cpu | mps | cuda
# 'auto' uses standard cross-OS providers without ad-hoc vendor hacks.
SIN_DSP_DEVICE=auto

# Async background cooking & windowed preview tuning.
SIN_COOK_WORKERS=1
SIN_COOK_DEBOUNCE_MS=500
SIN_PREVIEW_WINDOW_SEC=12.0

# Long-track (1h+) tiled streaming cache & precook defaults.
SIN_TILE_RAM_MB=256
SIN_TILE_SEC=8.0
SIN_PRECOOK_WINDOW_SEC=24.0
SIN_WAIT_FOR_FX=0

# Optional standard ML cache overrides (inherited from OS environment if unset).
# HF_HOME=
# TORCH_HOME=
